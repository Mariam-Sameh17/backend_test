generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../ERD.svg"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Coupons {
  couponId           Int                  @id @default(autoincrement())
  restaurantID       Int
  amount             Decimal              @db.Decimal(10, 2)
  available_uses     Int
  Restaurant         Restaurant           @relation(fields: [restaurantID], references: [restaurantId], onUpdate: NoAction)
  paymentWithCoupons paymentWithCoupons[]
}

model customerAddress {
  location   String @db.VarChar(100)
  customerId String @db.VarChar(50)
  Customer   Users  @relation(fields: [customerId], references: [userName], onDelete: Cascade, onUpdate: NoAction)

  @@id([location, customerId])
}

model customerSubscription {
  status                  String?                   @db.VarChar(20)
  startDate               DateTime?
  subscriptionId          String                    @db.VarChar(50)
  restaurantID            Int
  customerId              String                    @db.VarChar(50)
  paymentId               Int?
  Customer                Users                     @relation(fields: [customerId], references: [userName], onDelete: Cascade, onUpdate: NoAction)
  Payment                 Payment?                  @relation(fields: [paymentId], references: [paymentId], onDelete: NoAction, onUpdate: NoAction)
  Subscription            Subscription              @relation(fields: [subscriptionId, restaurantID], references: [planName, restaurantID], onDelete: Cascade, onUpdate: NoAction)
  paymentWithSubscription paymentWithSubscription[]

  @@id([customerId, subscriptionId, restaurantID])
}

model deliveryChat {
  messageId Int      @id @default(autoincrement())
  message   String   @db.VarChar(100)
  timeSent  DateTime
  status    String   @db.VarChar(20)
  SRFlag    String   @db.Char(1)
  orderId   Int?
  Orders    Orders?  @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
}

model deliveryPerson {
  userName        String            @id @db.VarChar(50)
  bankId          String            @db.VarChar(20)
  vehicleType     String            @db.VarChar(50)
  licenseNumber   String            @db.VarChar(20)
  id              String            @unique @db.VarChar(20)
  Users           Users             @relation(fields: [userName], references: [userName], onDelete: Cascade, onUpdate: NoAction)
  onDeliverOrders onDeliverOrders[]
}

model kitchenStaff {
  userName        String            @id @db.VarChar(50)
  restaurantId    Int
  Restaurant      Restaurant        @relation(fields: [restaurantId], references: [restaurantId], onUpdate: NoAction)
  Users           Users             @relation(fields: [userName], references: [userName], onDelete: Cascade, onUpdate: NoAction)
  onPrepareOrders onPrepareOrders[]
}

model menuItems {
  name         String       @db.VarChar(20)
  photo        String?      @db.VarChar(100)
  menuCategory String       @db.VarChar(50)
  price        Decimal      @db.Decimal(10, 2)
  finalPrice   Decimal?     @db.Decimal(10, 2)
  available    Boolean?
  description  String?      @db.VarChar(200)
  discount     Decimal?     @db.Decimal(10, 2)
  restaurantId Int
  Restaurant   Restaurant   @relation(fields: [restaurantId], references: [restaurantId], onDelete: Cascade, onUpdate: NoAction)
  orderItems   orderItems[]

  @@id([name, restaurantId])
}

model onDeliverOrders {
  deliveryTime   Decimal?       @db.Decimal(10, 2)
  deliveryId     String         @db.VarChar(50)
  tipAmount      Decimal?       @db.Decimal(10, 2)
  orderId        Int            @id
  deliveryPerson deliveryPerson @relation(fields: [deliveryId], references: [userName], onUpdate: NoAction)
  Orders         Orders         @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)
}

model onPrepareOrders {
  preparingTime  Decimal?     @db.Decimal(10, 2)
  kitchenStaffId String       @db.VarChar(50)
  orderId        Int          @id
  kitchenStaff   kitchenStaff @relation(fields: [kitchenStaffId], references: [userName], onDelete: Cascade, onUpdate: NoAction)
  Orders         Orders       @relation(fields: [orderId], references: [orderId], onUpdate: NoAction)
}

model orderItems {
  quantity     Int
  orderId      Int
  itemName     String    @db.VarChar(20)
  restaurantId Int?
  Orders       Orders    @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)
  menuItems    menuItems? @relation(fields: [itemName, restaurantId], references: [name, restaurantId], onDelete: Cascade)

  @@id([orderId, itemName])
}

model orderReview {
  deliverRating    Decimal? @db.Decimal(10, 2)
  restaurantRating Decimal? @db.Decimal(10, 2)
  customerId       String   @db.VarChar(50)
  orderId          Int      @id
  Customer         Users    @relation(fields: [customerId], references: [userName], onUpdate: NoAction)
  Orders           Orders   @relation(fields: [orderId], references: [orderId], onDelete: Cascade, onUpdate: NoAction)
}

model Orders {
  orderId                 Int                       @id @default(autoincrement())
  location                String                    @db.VarChar(100)
  orderTime               DateTime                  @db.Date
  itemsPrice              Decimal                   @db.Decimal(10, 2)
  deliveryFee             Decimal?                  @db.Decimal(10, 2)
  status                  String                    @db.VarChar(20)
  customerId              String                    @db.VarChar(50)
  restaurantId            Int
  deliveryChat            deliveryChat[]
  onDeliverOrders         onDeliverOrders?
  onPrepareOrders         onPrepareOrders?
  orderItems              orderItems[]
  orderReview             orderReview?
  Customer                Users                     @relation(fields: [customerId], references: [userName], onUpdate: NoAction)
  Restaurant              Restaurant                @relation(fields: [restaurantId], references: [restaurantId], onUpdate: NoAction)
  paymentWithCard_Wallet  paymentWithCard_Wallet[]
  paymentWithCoupons      paymentWithCoupons[]
  paymentWithSubscription paymentWithSubscription[]
  restaurantChat          restaurantChat[]
}

model Payment {
  paymentId               Int                       @id @default(autoincrement())
  amount                  Decimal                   @db.Decimal(10, 2)
  paymentStatus           String                    @db.VarChar(20)
  time                    DateTime
  customerSubscription    customerSubscription[]
  paymentWithCard_Wallet  paymentWithCard_Wallet?
  paymentWithCoupons      paymentWithCoupons?
  paymentWithSubscription paymentWithSubscription?
}

model paymentWithCard_Wallet {
  paymentAmount Float?
  paymentId     Int           @id
  customerId    String        @db.VarChar(50)
  number        String        @db.VarChar(20)
  orderId       Int?
  Orders        Orders?       @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
  Payment       Payment       @relation(fields: [paymentId], references: [paymentId], onDelete: Cascade, onUpdate: NoAction)
  Wallets_Cards Wallets_Cards @relation(fields: [number, customerId], references: [number, customerId], onUpdate: NoAction)
}

model paymentWithCoupons {
  paymentAmount Float?
  paymentId     Int     @id
  couponId      Int
  orderId       Int?
  Coupons       Coupons @relation(fields: [couponId], references: [couponId], onUpdate: NoAction)
  Orders        Orders? @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
  Payment       Payment @relation(fields: [paymentId], references: [paymentId], onDelete: Cascade, onUpdate: NoAction)
}

model paymentWithSubscription {
  paymentAmount        Float?
  paymentId            Int                  @id
  customerId           String               @db.VarChar(50)
  subscriptionId       String               @db.VarChar(50)
  restaurantID         Int
  orderId              Int?
  Orders               Orders?              @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
  Payment              Payment              @relation(fields: [paymentId], references: [paymentId], onDelete: Cascade, onUpdate: NoAction)
  customerSubscription customerSubscription @relation(fields: [customerId, subscriptionId, restaurantID], references: [customerId, subscriptionId, restaurantID], onDelete: Cascade, onUpdate: NoAction)
}

model proccessedTickets {
  responseMessage String   @db.VarChar(200)
  responseTime    DateTime
  ticketId        Int      @id
  supportId       String?  @db.VarChar(50)
  supportStaff    Users?   @relation(fields: [supportId], references: [userName], onDelete: NoAction, onUpdate: NoAction)
  Tickets         Tickets  @relation(fields: [ticketId], references: [ticketId], onDelete: Cascade, onUpdate: NoAction)
}

model Restaurant {
  restaurantId    Int               @id @default(autoincrement())
  category        String            @db.VarChar(50)
  photo           String?           @db.VarChar(100)
  openingHours    String            @db.VarChar(20)
  restaurantName  String            @unique @db.VarChar(50)
  description     String?           @db.VarChar(200)
  location        String            @db.VarChar(100)
  managerID       String            @db.VarChar(50)
  Coupons         Coupons[]
  kitchenStaff    kitchenStaff[]
  menuItems       menuItems[]
  Orders          Orders[]
  restaurantOwner restaurantOwner   @relation(fields: [managerID], references: [userName], onDelete: Cascade, onUpdate: NoAction)
  Subscription    Subscription[]
}

model restaurantChat {
  messageId Int      @id @default(autoincrement())
  message   String   @db.VarChar(100)
  timeSent  DateTime
  status    String   @db.VarChar(20)
  SRFlag    String   @db.Char(1)
  orderId   Int?
  Orders    Orders?  @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
}

model restaurantOwner {
  userName   String       @id @db.VarChar(50)
  bankId     String       @db.VarChar(20)
  Restaurant Restaurant[]
  Users      Users        @relation(fields: [userName], references: [userName], onDelete: Cascade, onUpdate: NoAction)
}

model Subscription {
  planName             String                 @db.VarChar(50)
  price                Decimal                @db.Decimal(10, 2)
  restaurantID         Int
  amount               Decimal                @db.Decimal(10, 2)
  FreeDelivery         Boolean?
  period               Int
  customerSubscription customerSubscription[]
  Restaurant           Restaurant             @relation(fields: [restaurantID], references: [restaurantId], onUpdate: NoAction)

  @@id([planName, restaurantID])
}

model Tickets {
  ticketId          Int                @id @default(autoincrement())
  subject           String?            @db.VarChar(50)
  message           String             @db.VarChar(200)
  status            String             @db.VarChar(20)
  createdAt         DateTime?
  customerId        String             @db.VarChar(50)
  proccessedTickets proccessedTickets?
  Customer          Users              @relation(fields: [customerId], references: [userName], onUpdate: NoAction)
}

model Wallets_Cards {
  number                 String                   @db.VarChar(20)
  type                   String                   @db.VarChar(10)
  customerId             String                   @db.VarChar(50)
  paymentWithCard_Wallet paymentWithCard_Wallet[]
  Customer               Users                    @relation(fields: [customerId], references: [userName], onDelete: Cascade, onUpdate: NoAction)

  @@id([number, customerId])
}

model Users {
  userName             String                 @id @db.VarChar(50)
  name                 String                 @db.VarChar(50)
  password             String                 @db.VarChar(100)
  photo                String?                @db.VarChar(100)
  email                String                 @db.VarChar(100)
  phoneNumber          String                 @db.VarChar(15)
  type                 String                 @db.Char(1)
  passwordChangedAt    DateTime?
  customerAddress      customerAddress[]
  customerSubscription customerSubscription[]
  deliveryPerson       deliveryPerson?
  kitchenStaff         kitchenStaff?
  orderReview          orderReview[]
  Orders               Orders[]
  proccessedTickets    proccessedTickets[]
  restaurantOwner      restaurantOwner?
  Tickets              Tickets[]
  Wallets_Cards        Wallets_Cards[]
}